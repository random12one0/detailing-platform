{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__Supabase",
      "mcp__Netlify",
      "mcp__Resend",
      "mcp__github",
      "Bash(psql:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(jq:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-ping.mjs"
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}